{
  "name": "aetherbound-idle",
  "private": true,
  "description": "A creature-collecting idle game.",
  "author": "Aetherbound Idle",
  "version": "0.1.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:start": "npm run build && electron .",
    "electron:smoke": "npm run build && node electron/smoke-runner.mjs",
    "electron:smoke:packaged": "node electron/smoke-runner.mjs --packaged",
    "electron:pack": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
